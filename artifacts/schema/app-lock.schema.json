{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "robot_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The robot whose capabilities are locked for this app."
    },
    "slugs": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "description": "The slugs of that robot's exposures to lock, at least one and each named once, at most 2000. A slug the robot has no exposure for is accepted and warns, and locks nothing."
    }
  },
  "required": [
    "robot_id",
    "slugs"
  ],
  "additionalProperties": false
}
