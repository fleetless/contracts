{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preview": {
      "type": "object",
      "properties": {
        "effects": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "changes",
                  "triggers",
                  "keeps"
                ],
                "description": "`changes`: a value moves from `from` to `to`. `triggers`: something is set off (a mail, a refund, a document). `keeps`: something explicitly stays as it is."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amount_cents": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "effects"
      ],
      "additionalProperties": false
    },
    "preview_token": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "preview",
    "preview_token"
  ],
  "additionalProperties": false
}
