{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The Lexware voucher id. Opaque; read the document or its file by this id, never a locally invented one."
    },
    "kind": {
      "type": "string",
      "enum": [
        "invoice",
        "credit_note",
        "down_payment_invoice",
        "bookkeeping_invoice",
        "bookkeeping_credit_note"
      ],
      "description": "The document's kind."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "overdue",
        "paid",
        "paidoff",
        "voided",
        "transferred",
        "sepadebit"
      ],
      "description": "The document's own status."
    },
    "number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Lexware voucher number, for display only — never a key to read by. `null` for a voucher Lexware has not numbered."
    },
    "document_date": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "The date printed on the document."
    },
    "currency": {
      "type": "string",
      "const": "EUR",
      "description": "Every Lexware voucher this reads is EUR; nothing here reads a foreign-currency voucher."
    },
    "gross_cents": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "The gross amount, in integer cents, signed by `kind` and never by the sign Lexware itself reports: `credit_note` and `bookkeeping_credit_note` are zero or negative, every other kind is zero or positive."
    },
    "file": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "description": "Whether Lexware holds a file for this document at all."
    },
    "electronic_document_profile": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "NONE",
            "EN16931",
            "XRechnung"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "The e-invoice profile, or `null` for a bookkeeping voucher — it has none."
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "xml"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "e_invoice",
              "preview",
              "document"
            ]
          }
        },
        "required": [
          "format",
          "role"
        ],
        "additionalProperties": false
      },
      "description": "`NONE`: `[{ format: \"pdf\", role: \"document\" }]`. `EN16931`: `[{ format: \"pdf\", role: \"e_invoice\" }]`. `XRechnung`: `[{ format: \"xml\", role: \"e_invoice\" }, { format: \"pdf\", role: \"preview\" }]`. `null` profile: `[{ format: \"pdf\", role: \"document\" }]` when `file` is `available`, otherwise `[]`."
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "number",
    "document_date",
    "currency",
    "gross_cents",
    "file",
    "electronic_document_profile",
    "formats"
  ],
  "additionalProperties": false
}
