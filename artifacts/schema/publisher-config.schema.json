{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "type": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\$\\{([a-z][a-z0-9]*(?:_[a-z0-9]+)*)\\}$"
        },
        {}
      ]
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "bool",
              "byte",
              "char",
              "int8",
              "uint8",
              "int16",
              "uint16",
              "int32",
              "uint32",
              "int64",
              "uint64",
              "float32",
              "float64",
              "string",
              "wstring"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "min_value": {
            "type": "number"
          },
          "max_value": {
            "type": "number"
          },
          "enum": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "regex": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "failsafe": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 60000
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$\\{([a-z][a-z0-9]*(?:_[a-z0-9]+)*)\\}$"
            },
            {}
          ]
        }
      },
      "required": [
        "timeout_ms",
        "message"
      ],
      "additionalProperties": false
    },
    "quiet_timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "topic",
    "type",
    "message",
    "failsafe",
    "quiet_timeout_ms"
  ],
  "additionalProperties": false
}
