{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "topic": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "type": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
    },
    "parameters": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "rule": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "enum": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "pattern": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "type",
          "rule"
        ]
      }
    },
    "timeout_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 60000
    },
    "failsafe": {},
    "quiet_timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "slug",
    "topic",
    "type",
    "parameters",
    "timeout_ms",
    "failsafe",
    "quiet_timeout_ms"
  ]
}
