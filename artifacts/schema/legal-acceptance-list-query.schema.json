{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0{0,2}[1-9]|0?[1-9][0-9]|100)$"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      ]
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "additionalProperties": false
}
