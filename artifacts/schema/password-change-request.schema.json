{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1
    },
    "new_password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256
    }
  },
  "required": [
    "current_password",
    "new_password"
  ]
}
