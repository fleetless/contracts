{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "window": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "agg": {
      "type": "string",
      "enum": [
        "min",
        "max",
        "avg"
      ]
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "limit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{1,5}$",
          "description": "Positive integer, 1-10000. The pattern only bounds digit count; the real ceiling is enforced after parsing."
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Positive integer, 1-10000. The ceiling is enforced after parsing, not by this type."
        }
      ]
    }
  },
  "required": [
    "from"
  ]
}
