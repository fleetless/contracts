{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "window": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "agg": {
      "type": "string",
      "enum": [
        "min",
        "max",
        "avg"
      ]
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "limit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "from"
  ],
  "additionalProperties": false
}
