{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "basic",
        "plus",
        "pro",
        "enterprise"
      ],
      "description": "The plan."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The plan's display name: Basic, Plus, Pro or Enterprise."
    },
    "limits": {
      "type": "object",
      "properties": {
        "seats": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Developers, owners included, plus pending team invitations."
        },
        "robots": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Robots in the org."
        },
        "apps": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Apps in the org."
        },
        "app_users": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "App users across every app of the org, plus pending app-user invitations."
        },
        "live_video_ms_per_month": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Live video watched by app users in one UTC calendar month, in milliseconds, across the org. Console sessions do not count."
        },
        "asset_bytes_per_robot": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Asset storage per robot, in bytes (decimal: 1 GB = 1,000,000,000). The org stores up to robots × this value in total."
        },
        "history_days": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Days the org's robot history is kept."
        },
        "audit_days": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Days the org's audit log is kept."
        }
      },
      "required": [
        "seats",
        "robots",
        "apps",
        "app_users",
        "live_video_ms_per_month",
        "asset_bytes_per_robot",
        "history_days",
        "audit_days"
      ],
      "additionalProperties": false,
      "description": "What the plan allows. `null` means by contract."
    },
    "features": {
      "type": "object",
      "properties": {
        "app_mcp": {
          "type": "boolean",
          "description": "An app's own MCP endpoint, for its app users."
        },
        "two_factor": {
          "type": "boolean",
          "description": "Two-factor sign-in for developers."
        },
        "require_two_factor": {
          "type": "boolean",
          "description": "An owner may require two-factor sign-in for every developer of the org."
        },
        "app_oidc": {
          "type": "boolean",
          "description": "An app may let its users sign in through an OpenID Connect identity provider."
        },
        "hosted_logo": {
          "type": "boolean",
          "description": "An app's hosted pages show its logo and accent colour, not only its name."
        },
        "audit_export": {
          "type": "boolean",
          "description": "The audit log can be exported as CSV."
        },
        "addons": {
          "type": "boolean",
          "description": "Add-ons can be bought on top of the plan."
        }
      },
      "required": [
        "app_mcp",
        "two_factor",
        "require_two_factor",
        "app_oidc",
        "hosted_logo",
        "audit_export",
        "addons"
      ],
      "additionalProperties": false,
      "description": "What the plan unlocks."
    },
    "prices": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "eur_month": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Per month in euro cents, excluding VAT."
            },
            "usd_month": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Per month in US dollar cents, excluding VAT: the euro price × 1.15, rounded up to a whole dollar."
            },
            "eur_year": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Per year in euro cents, excluding VAT: twelve months less 15 %."
            },
            "usd_year": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Per year in US dollar cents, excluding VAT: the yearly euro price × 1.15, rounded up to a whole dollar."
            }
          },
          "required": [
            "eur_month",
            "usd_month",
            "eur_year",
            "usd_year"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "`null` for Enterprise: sold by contract, on request."
    },
    "support": {
      "type": "string",
      "enum": [
        "community",
        "email",
        "priority",
        "named_contact"
      ],
      "description": "The support that comes with the plan."
    }
  },
  "required": [
    "id",
    "name",
    "limits",
    "features",
    "prices",
    "support"
  ],
  "additionalProperties": false
}
