{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "client_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "redirect_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "grant_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_endpoint_auth_method": {
      "type": "string",
      "const": "none"
    },
    "client_id_issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "client_secret_expires_at": {
      "type": "number",
      "const": 0
    }
  },
  "required": [
    "client_id",
    "client_name",
    "redirect_uris",
    "grant_types",
    "response_types",
    "token_endpoint_auth_method",
    "client_id_issued_at",
    "client_secret_expires_at"
  ],
  "additionalProperties": false
}
