{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "enum": [
        "seats",
        "robots",
        "apps",
        "app_users",
        "live_video_ms_per_month",
        "asset_bytes_per_robot"
      ],
      "description": "The limit the action would exceed."
    },
    "used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "How much of the limit the org uses now."
    },
    "max": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The limit. For `asset_bytes_per_robot`, the org's whole pool: robots × the plan's bytes per robot."
    },
    "plan": {
      "type": "string",
      "enum": [
        "basic",
        "plus",
        "pro",
        "enterprise"
      ],
      "description": "The plan whose limit refused: the target plan while a move to a lower plan is pending."
    },
    "lifted_by": {
      "type": "object",
      "properties": {
        "plan": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "basic",
                "plus",
                "pro",
                "enterprise"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The cheapest higher plan that raises this limit, or `null` when none does."
        },
        "addon": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "seats",
                "robots",
                "apps",
                "app_user_packs",
                "live_video_packs"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The add-on that raises this limit, when the org's plan can buy add-ons; otherwise `null`."
        }
      },
      "required": [
        "plan",
        "addon"
      ],
      "additionalProperties": false,
      "description": "What would lift the limit."
    },
    "store_bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The org's asset pool, in bytes: `robots × asset_bytes_per_robot`."
    },
    "used_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Bytes the org's assets occupy, across every robot, before this upload."
    },
    "size_bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The refused upload, in bytes."
    }
  },
  "required": [
    "limit",
    "used",
    "max",
    "plan",
    "lifted_by",
    "store_bytes",
    "used_bytes",
    "size_bytes"
  ],
  "additionalProperties": false
}
