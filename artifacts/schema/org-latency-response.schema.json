{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "robot_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bucket_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "min_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avg_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "samples": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "online_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                }
              },
              "required": [
                "bucket_at",
                "min_ms",
                "avg_ms",
                "max_ms",
                "samples",
                "online_ms"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "robot_id",
          "buckets"
        ],
        "additionalProperties": false
      }
    },
    "from_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "to_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "truncated": {
      "type": "boolean"
    },
    "truncated_by": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "limit",
            "bytes"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "series",
    "from_ms",
    "to_ms",
    "truncated",
    "truncated_by"
  ],
  "additionalProperties": false
}
