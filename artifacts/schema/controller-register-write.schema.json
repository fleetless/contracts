{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "legalName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\P{Cc}*$"
    },
    "address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\P{Cc}*$"
        },
        "line2": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\P{Cc}*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "postalCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^\\P{Cc}*$"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^\\P{Cc}*$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "line1",
        "postalCode",
        "city",
        "country"
      ],
      "additionalProperties": false
    },
    "privacyContact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\P{Cc}*$"
            },
            "email": {
              "type": "string",
              "maxLength": 320,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "role": {
              "type": "string",
              "enum": [
                "general",
                "appointed_dpo"
              ]
            }
          },
          "required": [
            "name",
            "email",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "euRepresentative": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^\\P{Cc}*$"
            },
            "email": {
              "type": "string",
              "maxLength": 320,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^\\P{Cc}*$"
            }
          },
          "required": [
            "name",
            "email",
            "address"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmationSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\P{Cc}*$"
    }
  },
  "required": [
    "legalName",
    "address",
    "privacyContact",
    "euRepresentative",
    "confirmationSource"
  ],
  "additionalProperties": false
}
