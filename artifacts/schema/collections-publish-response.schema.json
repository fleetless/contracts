{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "collection_removed"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records deleted with the collection."
              }
            },
            "required": [
              "kind",
              "collection",
              "records"
            ],
            "additionalProperties": false,
            "description": "The collection is gone from the document, so its records are deleted."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "collection_recreated"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records deleted by the re-creation."
              },
              "from": {
                "type": "string",
                "enum": [
                  "global",
                  "per_robot",
                  "one_per_robot"
                ],
                "description": "`global`: records belong to the app and no robot. `per_robot`: every record belongs to one robot (system field `robot_id`, fixed when the record is created). `one_per_robot`: every robot of the app has exactly one record, which Fleetless creates itself."
              },
              "to": {
                "type": "string",
                "enum": [
                  "global",
                  "per_robot",
                  "one_per_robot"
                ],
                "description": "`global`: records belong to the app and no robot. `per_robot`: every record belongs to one robot (system field `robot_id`, fixed when the record is created). `one_per_robot`: every robot of the app has exactly one record, which Fleetless creates itself."
              }
            },
            "required": [
              "kind",
              "collection",
              "records",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "description": "The binding of the collection changed, which deletes its records and starts the collection again."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "records_created"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records created, one for each robot attached to the app."
              }
            },
            "required": [
              "kind",
              "collection",
              "count"
            ],
            "additionalProperties": false,
            "description": "A collection with one record per robot got the records of the robots that have none."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "field_removed"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values removed from records."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "values"
            ],
            "additionalProperties": false,
            "description": "The field is gone from the document, so its values are removed from the records."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "defaults_filled"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records that receive the default."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "records"
            ],
            "additionalProperties": false,
            "description": "Records without a value get the default of a new or newly required field."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "values_converted"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "converted": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values that became a value of the new type."
              },
              "discarded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values that could not be converted and were removed."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "converted",
              "discarded"
            ],
            "additionalProperties": false,
            "description": "The type of the field changed: values are converted where the conversion rules allow it and removed where they do not."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "values_discarded"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "reference_target_changed",
                  "option_removed",
                  "constraint"
                ],
                "description": "`reference_target_changed`: the field points at another collection now. `option_removed`: a select option is gone. `constraint`: a limit such as `max_length`, `pattern`, `min`, `max`, `integer` or the JSON schema now excludes the value."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values removed from records."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "reason",
              "values"
            ],
            "additionalProperties": false,
            "description": "Values that the changed field no longer accepts are removed."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "unique_discarded"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The exact number of values removed."
              },
              "records": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "display": {
                      "type": "string",
                      "description": "The record's display text."
                    },
                    "value": {
                      "description": "The value the record loses."
                    }
                  },
                  "required": [
                    "id",
                    "display",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "description": "The records that lose their value, at most 1000; `total` is the exact number."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "total",
              "records"
            ],
            "additionalProperties": false,
            "description": "The field became unique, or unique across a wider scope, and records share a value: the record created first keeps it and the others lose it."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "required_left_empty"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records left without a value."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "records"
            ],
            "additionalProperties": false,
            "description": "The field is required now and these records have no value and no default to fill in; they stay updatable in their other fields."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "references_cleared"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "References removed."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "values"
            ],
            "additionalProperties": false,
            "description": "References that pointed at records deleted by this change are cleared."
          }
        ],
        "description": "One effect of a publish or restore on existing data. Effects that would change nothing are not listed."
      },
      "description": "What the publish did to existing data."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Where in the document, with dots between the keys: `collections.chargers.fields.location.to`."
          },
          "code": {
            "type": "string",
            "description": "A stable name for the kind of finding, for code to branch on."
          },
          "message": {
            "type": "string",
            "description": "What is wrong, in a sentence for a person."
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ],
            "description": "An error makes the document invalid and it cannot be saved or published. A warning and information leave it valid."
          }
        },
        "required": [
          "path",
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false,
        "description": "One finding about a collections document."
      },
      "description": "Warnings and information about the published document."
    }
  },
  "required": [
    "version",
    "published_at",
    "effects",
    "issues"
  ],
  "additionalProperties": false,
  "description": "The version that was published and the effects it had."
}
