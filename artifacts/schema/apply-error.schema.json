{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "datapoint",
        "action",
        "service",
        "publisher",
        "camera",
        "low_bandwidth"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "slug",
    "kind",
    "code",
    "message"
  ]
}
