{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "datapoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "builtin": {
            "type": "boolean"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rate_throttle_hz": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "builtin",
          "unit",
          "rate_throttle_hz"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "datapoints"
  ],
  "additionalProperties": false
}
