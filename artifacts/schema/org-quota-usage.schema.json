{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "quotas": {
      "type": "object",
      "properties": {
        "max_robots": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_apps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_end_users": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_retention_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_retention_writes_per_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_realtime_connections": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "collection_records": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "The most records the app collections of all the org's apps may hold together: the plan limit `collection_records`, or the operator's override of it. `null` is by contract (Enterprise)."
        },
        "collection_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "The most bytes the current records of the org's app collections may occupy together: the plan limit `collection_bytes`, or the operator's override of it. `null` is by contract (Enterprise)."
        }
      },
      "required": [
        "max_robots",
        "max_apps",
        "max_end_users",
        "max_retention_bytes",
        "max_retention_writes_per_minute",
        "max_realtime_connections",
        "collection_records",
        "collection_bytes"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "max_robots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_apps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_end_users": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_retention_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_retention_writes_per_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_realtime_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Current records in the app collections of all the org's apps. Deleted records do not count."
        },
        "collection_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Bytes the current records of the org's app collections occupy, as stored JSON."
        },
        "collection_history_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Bytes the history of the org's app collections occupies: revisions of current and deleted records. Information only; no limit applies to it."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "quotas",
    "usage"
  ],
  "additionalProperties": false
}
