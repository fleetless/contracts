{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "seats",
        "robots",
        "apps",
        "app_user_packs",
        "live_video_packs"
      ],
      "description": "The add-on."
    },
    "raises": {
      "type": "string",
      "enum": [
        "seats",
        "robots",
        "apps",
        "app_users",
        "live_video_ms_per_month",
        "asset_bytes_per_robot",
        "history_days",
        "audit_days"
      ],
      "description": "The plan limit this add-on raises."
    },
    "per_unit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "How much one unit of this add-on raises `raises` by."
    },
    "prices": {
      "type": "object",
      "properties": {
        "eur_month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Per month in euro cents, excluding VAT."
        },
        "eur_year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Per year in euro cents, excluding VAT: twelve months less 15 %."
        }
      },
      "required": [
        "eur_month",
        "eur_year"
      ],
      "additionalProperties": false,
      "description": "The price of one unit."
    }
  },
  "required": [
    "key",
    "raises",
    "per_unit",
    "prices"
  ],
  "additionalProperties": false
}
