{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "mollie",
      "description": "The payment provider. Always `mollie` today."
    },
    "status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "Mollie's own HTTP status, or `null` when the request timed out instead of answering."
    }
  },
  "required": [
    "provider",
    "status"
  ],
  "additionalProperties": false
}
