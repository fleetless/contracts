{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The version that would be restored."
    },
    "with_data": {
      "type": "boolean",
      "description": "Whether this preview is for a restore that also puts records back."
    },
    "data_possible": {
      "type": "boolean",
      "description": "Whether records can be put back at all."
    },
    "data_reason": {
      "type": "string",
      "enum": [
        "ok",
        "expired",
        "purged",
        "current_version"
      ],
      "description": "`ok`: records can be put back. `expired`: the restore point is more than 90 days old. `purged`: an owner removed the history it needs. `current_version`: this version is already in force."
    },
    "touched": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,62}$",
        "description": "The key of the collection."
      },
      "description": "The collections that differ between the current version and this one; only these can get records back."
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,62}$",
        "description": "The key of the collection."
      },
      "description": "The touched collections whose records would be put back. The caller may deselect some."
    },
    "reverted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "description": "The key of the collection."
          },
          "changes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Changes made since the restore point that would be reverted."
          },
          "records_back": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Deleted records that would come back."
          },
          "records_deleted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Records created since the restore point that would be deleted."
          }
        },
        "required": [
          "collection",
          "changes",
          "records_back",
          "records_deleted"
        ],
        "additionalProperties": false
      },
      "description": "What putting the records back would do, per selected collection."
    },
    "robots_gone": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Records of robots that were deleted since cannot come back; this is how many."
    },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "collection_removed"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records deleted with the collection."
              }
            },
            "required": [
              "kind",
              "collection",
              "records"
            ],
            "additionalProperties": false,
            "description": "The collection is gone from the document, so its records are deleted. Their history is deleted 90 days after the publish or restore that removed the collection, also when it held no records any more by then; until then a restore of an earlier version with its data can bring the records back."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "collection_recreated"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records deleted by the re-creation."
              },
              "from": {
                "type": "string",
                "enum": [
                  "global",
                  "per_robot",
                  "one_per_robot"
                ],
                "description": "`global`: records belong to the app and no robot. `per_robot`: every record belongs to one robot (system field `robot_id`, fixed when the record is created). `one_per_robot`: every robot of the app has exactly one record, which Fleetless creates itself."
              },
              "to": {
                "type": "string",
                "enum": [
                  "global",
                  "per_robot",
                  "one_per_robot"
                ],
                "description": "`global`: records belong to the app and no robot. `per_robot`: every record belongs to one robot (system field `robot_id`, fixed when the record is created). `one_per_robot`: every robot of the app has exactly one record, which Fleetless creates itself."
              }
            },
            "required": [
              "kind",
              "collection",
              "records",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "description": "The binding of the collection changed, which deletes its records and starts the collection again. The history of the deleted records is kept 90 days after the publish or restore, as for a removed collection."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "records_created"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records created, one for each robot attached to the app."
              }
            },
            "required": [
              "kind",
              "collection",
              "count"
            ],
            "additionalProperties": false,
            "description": "A collection with one record per robot got the records of the robots that have none."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "field_removed"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values removed from records."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "values"
            ],
            "additionalProperties": false,
            "description": "The field is gone from the document, so its values are removed from the records."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "defaults_filled"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records that receive the default."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "records"
            ],
            "additionalProperties": false,
            "description": "Records without a value get the default of a new or newly required field."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "values_converted"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "converted": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values that became a value of the new type."
              },
              "discarded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values that could not be converted and were removed."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "converted",
              "discarded"
            ],
            "additionalProperties": false,
            "description": "The type of the field changed: values are converted where the conversion rules allow it and removed where they do not."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "values_discarded"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "reference_target_changed",
                  "option_removed",
                  "constraint"
                ],
                "description": "`reference_target_changed`: the field points at another collection now. `option_removed`: a select option is gone. `constraint`: a limit such as `max_length`, `pattern`, `min`, `max`, `integer` or the JSON schema now excludes the value."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Values removed from records."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "reason",
              "values"
            ],
            "additionalProperties": false,
            "description": "Values that the changed field no longer accepts are removed."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "unique_discarded"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The exact number of values removed."
              },
              "records": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "display": {
                      "type": "string",
                      "description": "The record's display text."
                    },
                    "value": {
                      "description": "The value the record loses."
                    }
                  },
                  "required": [
                    "id",
                    "display",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "description": "The records that lose their value, at most 1000; `total` is the exact number."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "total",
              "records"
            ],
            "additionalProperties": false,
            "description": "The field became unique, or unique across a wider scope, and records share a value: the record created first keeps it and the others lose it."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "required_left_empty"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Records left without a value."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "records"
            ],
            "additionalProperties": false,
            "description": "The field is required now and these records have no value and no default to fill in; they stay updatable in their other fields."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "references_cleared"
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the collection."
              },
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "description": "The key of the field."
              },
              "values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "References removed."
              }
            },
            "required": [
              "kind",
              "collection",
              "field",
              "values"
            ],
            "additionalProperties": false,
            "description": "References that pointed at records deleted by this change are cleared."
          }
        ],
        "description": "One effect of a publish or restore on existing data. Effects that would change nothing are not listed."
      },
      "description": "The ordinary effects of publishing this version's document."
    },
    "access_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "description": "The key of the collection."
          },
          "action": {
            "type": "string",
            "enum": [
              "read",
              "create",
              "update",
              "delete"
            ]
          },
          "from": {
            "description": "The access before, as written in the document. `null` means nobody."
          },
          "to": {
            "description": "The access after, as written in the document. `null` means nobody."
          }
        },
        "required": [
          "collection",
          "action",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "description": "A change of the roles that may do one thing with the records of a collection. Information only; it does not need confirming."
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Where in the document, with dots between the keys: `collections.chargers.fields.location.to`."
          },
          "code": {
            "type": "string",
            "description": "A stable name for the kind of finding, for code to branch on."
          },
          "message": {
            "type": "string",
            "description": "What is wrong, in a sentence for a person."
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ],
            "description": "An error makes the document invalid and it cannot be saved or published. A warning and information leave it valid."
          }
        },
        "required": [
          "path",
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false,
        "description": "One finding about a collections document."
      }
    },
    "token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Stands for exactly what this restore would do: send it as `confirm`. Null when the restore changes no data and needs no confirmation."
    }
  },
  "required": [
    "version",
    "with_data",
    "data_possible",
    "data_reason",
    "touched",
    "selected",
    "reverted",
    "robots_gone",
    "effects",
    "access_changes",
    "issues",
    "token"
  ],
  "additionalProperties": false,
  "description": "The preview of restoring a version, with the token that confirms it."
}
