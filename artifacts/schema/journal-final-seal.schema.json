{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "fleetless.journal-final-seal.v1"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "isolated_target_id": {
      "type": "string",
      "minLength": 1
    },
    "restore_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "final_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "final_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "selected_recovery_point": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timestamp"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "lsn"
            },
            "timeline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "lsn": {
              "type": "string",
              "pattern": "^(?:0|[1-9A-F][0-9A-F]{0,7})\\/(?:0|[1-9A-F][0-9A-F]{0,7})$"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            }
          },
          "required": [
            "kind",
            "timeline",
            "lsn",
            "at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fence_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "e_max_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "w_max_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deployment_admission_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cutoff_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "previous_cutoff_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "registry_chain_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "copy_inventory_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pinned_standby_id": {
      "type": "string",
      "minLength": 1
    },
    "seal_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  },
  "required": [
    "schema",
    "environment",
    "signing_key_id",
    "incident_id",
    "isolated_target_id",
    "restore_attempt_id",
    "final_sequence",
    "final_hash",
    "final_generation",
    "selected_recovery_point",
    "fence_at",
    "e_max_ms",
    "w_max_ms",
    "deployment_admission_evidence_digest",
    "cutoff_utc",
    "previous_cutoff_utc",
    "registry_chain_digest",
    "copy_inventory_digest",
    "pinned_standby_id",
    "seal_hash",
    "signature"
  ],
  "additionalProperties": false
}
