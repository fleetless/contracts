{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "before": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "collection": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "description": "A collection key or a field key: `^[a-z][a-z0-9_]{0,62}$`. Keys appear in URLs, filters and record bodies; `label` is the text people read."
        },
        {
          "type": "null"
        }
      ],
      "description": "The collection the purge is limited to. Null for the whole app."
    },
    "revisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Revisions that would be removed."
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Their size in bytes."
    },
    "restore_points_lost": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "description": "Versions whose records can no longer be restored once the history is gone."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "Stands for exactly this purge: send it as `confirm` to carry it out."
    }
  },
  "required": [
    "before",
    "collection",
    "revisions",
    "bytes",
    "restore_points_lost",
    "token"
  ],
  "additionalProperties": false,
  "description": "What a purge would remove, with the token that confirms it."
}
