{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "primary_color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "logo_data_uri": {
      "type": "string",
      "maxLength": 349528,
      "pattern": "^data:image\\/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$"
    },
    "footer_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "primary_color"
  ]
}
