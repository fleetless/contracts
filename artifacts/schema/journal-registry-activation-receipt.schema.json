        "copy_coverage_digest",
        "coverage_verdict",
        "control_sequence",
        "old_registry_digest",
        "old_registry_version_id",
        "old_build_set_digest",
        "old_build_set_version_id",
        "previous_receipt_hash",
        "receipt_hash",
        "signature"
      ],
