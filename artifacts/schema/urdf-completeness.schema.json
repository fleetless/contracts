{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "present": {
      "type": "boolean"
    },
    "mesh_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "element": {
            "type": "string",
            "enum": [
              "mesh",
              "texture"
            ]
          }
        },
        "required": [
          "uri",
          "element"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "present",
    "mesh_count",
    "missing"
  ],
  "additionalProperties": false
}
