{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "idp_logout": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "redirect"
            },
            "url": {
              "type": "string",
              "maxLength": 2000,
              "format": "uri"
            }
          },
          "required": [
            "status",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "not_federated"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unsupported_by_idp"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "hint_unavailable"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "session_unknown"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "idp_logout"
  ],
  "additionalProperties": false
}
