{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "const": "buckets"
    },
    "window_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "agg": {
      "type": "string",
      "enum": [
        "min",
        "max",
        "avg"
      ]
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bucket_start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "bucket_start_ms",
          "value",
          "sample_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "slug",
    "kind",
    "window_ms",
    "agg",
    "buckets"
  ],
  "additionalProperties": false
}
