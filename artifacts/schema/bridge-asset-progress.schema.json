{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "asset_progress"
    },
    "sync_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "done": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "enum": [
              "unresolvable",
              "upload_failed",
              "refused",
              "too_large"
            ]
          },
          "details": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "limit_bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "size_bytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "limit_bytes",
                  "size_bytes"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reference",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "finished",
        "refused_busy"
      ]
    }
  },
  "required": [
    "type",
    "sync_id",
    "done",
    "total",
    "failed",
    "state"
  ],
  "additionalProperties": false
}
