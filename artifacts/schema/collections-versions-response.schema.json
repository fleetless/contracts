{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "current": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "The version in force. Null before the first publish."
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "published_by": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "developer",
                  "app_user",
                  "server_key",
                  "fleetless"
                ],
                "description": "What made the change: a developer, a user of the app, a server key of the app, or the platform itself."
              },
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "The id of the developer, app user or server key. The nil id for the platform."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "A name to show: an email address, a key name, `Fleetless`, or `Deleted user` when the user no longer exists."
              }
            },
            "required": [
              "kind",
              "id",
              "label"
            ],
            "additionalProperties": false,
            "description": "Who or what made a change to a record."
          },
          "effect_counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "For each kind of effect the publish had, how many records or values it touched, by effect `kind`. Empty when it had none."
          },
          "restored_from": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "The version this one restored. Null for an ordinary publish."
          },
          "restore_with_data": {
            "type": "boolean",
            "description": "Whether restoring this version can also put records back: its restore point is at most 90 days old, has not been purged, and it is not the current version."
          }
        },
        "required": [
          "version",
          "published_at",
          "published_by",
          "effect_counts",
          "restored_from",
          "restore_with_data"
        ],
        "additionalProperties": false,
        "description": "A published version of the schema document."
      },
      "description": "Newest first."
    }
  },
  "required": [
    "current",
    "versions"
  ],
  "additionalProperties": false,
  "description": "The published versions of the schema document."
}
