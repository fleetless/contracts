{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "name",
    "identifier"
  ],
  "additionalProperties": false
}
