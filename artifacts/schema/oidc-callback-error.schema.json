{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "idp_unreachable",
        "exchange_failed",
        "claims_incomplete",
        "jit_disabled",
        "email_collision",
        "provider_misconfigured"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": false
}
