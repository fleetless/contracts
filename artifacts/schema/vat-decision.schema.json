{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "eligible"
        },
        "treatment": {
          "type": "string",
          "enum": [
            "de_standard",
            "reverse_charge",
            "outside_eu"
          ]
        },
        "rate_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "state",
        "treatment",
        "rate_percent"
      ],
      "additionalProperties": false
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "pending"
            },
            "reason": {
              "type": "string",
              "const": "vies_unavailable"
            },
            "vies_outage": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "enum": [
                    "member_state",
                    "vies"
                  ],
                  "description": "`member_state`: the VAT register of `country` does not answer VIES. `vies`: VIES itself does not answer."
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "description": "The billing address's country whose VAT ID was asked for. Greece is `GR`, never VIES's `EL`."
                }
              },
              "required": [
                "scope",
                "country"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "reason",
            "vies_outage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "pending"
            },
            "reason": {
              "type": "string",
              "enum": [
                "vies_unverified",
                "vies_identifier_missing"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "refused"
        },
        "rule": {
          "type": "string",
          "enum": [
            "company_required",
            "vat_id_required",
            "vat_id_invalid"
          ]
        }
      },
      "required": [
        "state",
        "rule"
      ],
      "additionalProperties": false
    }
  ]
}
