{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operation_key": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Client-generated UUID persisted before the start request. Unique per org and reused only for identical input."
    },
    "operation": {
      "type": "string",
      "const": "paid_change"
    },
    "state": {
      "type": "string",
      "const": "accepted_no_payment"
    },
    "quote_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque revision of the displayed quote; echo it when confirming."
    },
    "buyer_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque revision of buyer details and email policy; never full VIES evidence."
    },
    "quote": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "eur",
          "description": "Every new quote is in EUR."
        },
        "net_cents": {
          "type": "number",
          "const": 0
        },
        "vat_cents": {
          "type": "number",
          "const": 0
        },
        "gross_cents": {
          "type": "number",
          "const": 0
        },
        "rate_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "VAT rate in whole percent."
        }
      },
      "required": [
        "currency",
        "net_cents",
        "vat_cents",
        "gross_cents",
        "rate_percent"
      ],
      "additionalProperties": false
    },
    "accepted_at": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "pattern": "Z$"
        }
      ]
    }
  },
  "required": [
    "intent_id",
    "operation_key",
    "operation",
    "state",
    "quote_revision",
    "buyer_fingerprint",
    "quote",
    "accepted_at"
  ],
  "additionalProperties": false
}
