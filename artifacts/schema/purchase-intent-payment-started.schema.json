{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Opaque persisted purchase intent identity."
    },
    "operation_key": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "Client-generated UUID persisted before the start request. Unique per org and reused only for identical input."
    },
    "operation": {
      "type": "string",
      "enum": [
        "checkout",
        "paid_change",
        "invoice_payment",
        "payment_method_invoice"
      ]
    },
    "invoice_id": {
      "description": "The due charge or issued invoice, for invoice-paying operations.",
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "state": {
      "type": "string",
      "const": "payment_started"
    },
    "payment_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "payment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hosted"
            },
            "checkout_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "checkout_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "checkout_id",
            "checkout_url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mandate"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "intent_id",
    "operation_key",
    "operation",
    "state",
    "payment_id",
    "payment"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "invoice_payment",
              "payment_method_invoice"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "invoice_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "mandate_setup"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "held"
          },
          "reason": {
            "const": "mandate_policy_unresolved"
          }
        },
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "mandate_policy_unresolved"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": "mandate_setup"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payment": {
            "properties": {
              "kind": {
                "const": "mandate"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "payment"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "const": "paid_change"
          }
        }
      }
    }
  ]
}
