{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "datapoint",
              "action",
              "service",
              "publisher",
              "camera"
            ]
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "kind",
          "builtin"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "exposures"
  ],
  "additionalProperties": false
}
