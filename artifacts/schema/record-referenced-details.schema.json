{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "references": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "minLength": 1,
            "description": "The key of a collection that has records pointing at this one."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "How many records of that collection point at it."
          }
        },
        "required": [
          "collection",
          "count"
        ],
        "additionalProperties": false
      },
      "description": "The collections whose records reference the record, each with how many."
    }
  },
  "required": [
    "references"
  ],
  "additionalProperties": false
}
