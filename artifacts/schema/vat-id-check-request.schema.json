{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "The VAT ID's country."
    },
    "vat_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "The VAT ID as typed; normalized before the VIES lookup (`normalizeVatId`)."
    }
  },
  "required": [
    "country",
    "vat_id"
  ],
  "additionalProperties": false
}
