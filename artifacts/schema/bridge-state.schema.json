{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "online": {
      "type": "boolean"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "low_bandwidth": {
      "type": "boolean",
      "description": "Whether the bridge is in its low-bandwidth mode: datapoints capped, cameras reduced or stopped. Bridge-reported."
    }
  },
  "required": [
    "online",
    "latency_ms",
    "low_bandwidth"
  ]
}
