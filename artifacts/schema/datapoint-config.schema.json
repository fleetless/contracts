{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "type": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
    },
    "field": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
    },
    "rate_throttle_hz": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "numeric": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_buffer_values": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "properties": {
        "y_min": {
          "type": "number"
        },
        "y_max": {
          "type": "number"
        },
        "style": {
          "type": "string",
          "enum": [
            "line",
            "step"
          ]
        },
        "default_window_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "object",
            "properties": {
              "fire_at": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "resolve_at": {
                "type": "number"
              }
            },
            "required": [
              "fire_at"
            ],
            "additionalProperties": false
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "condition"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "topic",
    "type"
  ],
  "additionalProperties": false
}
