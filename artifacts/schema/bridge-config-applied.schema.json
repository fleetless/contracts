{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "config_applied"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ok": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slug",
          "message"
        ]
      }
    }
  },
  "required": [
    "type",
    "version",
    "ok",
    "errors"
  ]
}
