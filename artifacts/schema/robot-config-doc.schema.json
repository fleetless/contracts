{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "datapoints": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "type": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rate": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "max_hz"
                  },
                  "hz": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "mode",
                  "hz"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "on_change"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "offset": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "max": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "retention": {
            "type": "null"
          },
          "buffer": {
            "default": {
              "enabled": false,
              "max_values": 0
            },
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "max_values": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            },
            "required": [
              "enabled",
              "max_values"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "slug",
          "topic",
          "type",
          "field",
          "rate",
          "unit",
          "scale",
          "offset",
          "range",
          "buffer"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "ros_name": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "type": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
          },
          "parameters": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "rule": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "enum": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "rule"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "ros_name",
          "type",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "ros_name": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "type": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
          },
          "parameters": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "rule": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "enum": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "rule"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "ros_name",
          "type",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "publishers": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "type": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
          },
          "parameters": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z_][a-z0-9_]*(?:\\[\\d+\\])*(?:\\.[a-z_][a-z0-9_]*(?:\\[\\d+\\])*)*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "rule": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "enum": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "rule"
              ],
              "additionalProperties": false
            }
          },
          "timeout_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 60000
          },
          "failsafe": {},
          "quiet_timeout_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          }
        },
        "required": [
          "slug",
          "topic",
          "type",
          "parameters",
          "timeout_ms",
          "failsafe",
          "quiet_timeout_ms"
        ],
        "additionalProperties": false
      }
    },
    "cameras": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "type": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 4320
          },
          "fps": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "bitrate_kbps": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50000
          },
          "snapshot_interval_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 3600000
          }
        },
        "required": [
          "slug",
          "topic",
          "type",
          "width",
          "height",
          "fps",
          "bitrate_kbps",
          "snapshot_interval_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "datapoints",
    "actions",
    "services",
    "publishers",
    "cameras"
  ],
  "additionalProperties": false
}
