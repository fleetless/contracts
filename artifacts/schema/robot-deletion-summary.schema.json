{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sample_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bytes_freed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "had_live_session": {
      "type": "boolean"
    }
  },
  "required": [
    "slug_count",
    "sample_rows",
    "bytes_freed",
    "cameras",
    "had_live_session"
  ],
  "additionalProperties": false
}
