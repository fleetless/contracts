{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The due charge's id — never a Cloud invoice number. Pay it with `POST /api/billing/charges/:id/pay`."
    },
    "kind": {
      "type": "string",
      "enum": [
        "first",
        "renewal",
        "change"
      ],
      "description": "What caused the charge: the first charge after checkout, a scheduled renewal, or a mid-period plan change."
    },
    "status": {
      "type": "string",
      "enum": [
        "due",
        "paid",
        "uncollectible",
        "cancelled"
      ],
      "description": "The charge's own status. A charged back or manually refunded charge stays `paid` — refunds and chargebacks are handled in Mollie or Lexware by hand; this status and the invoice it names are unchanged, and the resulting Lexware credit note appears under `GET /api/billing/documents` instead."
    },
    "currency": {
      "type": "string",
      "const": "eur",
      "description": "Every charge billed through Lexware is EUR."
    },
    "net_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The charge, excluding VAT, in integer cents."
    },
    "vat_rate_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "The VAT rate applied, in whole percent."
    },
    "vat_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "VAT, in integer cents (`vatCents`)."
    },
    "gross_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Net plus VAT, in integer cents."
    },
    "period_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "The covered period's start."
    },
    "period_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "The covered period's end."
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "When this charge is due."
    },
    "paid_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ],
      "description": "When this charge was paid, or `null` while unpaid."
    },
    "invoice": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "not_issued",
              "description": "Not collected (due, a failed retry, or uncollectible): no invoice exists."
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "pending",
              "description": "Collected; the Lexware invoice is not yet confirmed."
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "issued",
              "description": "Lexware has confirmed the invoice."
            },
            "document_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The Lexware document's id — read it with `GET /api/billing/documents/:id`."
            }
          },
          "required": [
            "state",
            "document_id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Whether a Lexware invoice exists for this charge yet, and which document it names once it does."
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "currency",
    "net_cents",
    "vat_rate_percent",
    "vat_cents",
    "gross_cents",
    "period_start",
    "period_end",
    "due_at",
    "paid_at",
    "invoice"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "paid"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "invoice": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "issued"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "due",
              "uncollectible",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "invoice": {
            "properties": {
              "state": {
                "const": "not_issued"
              }
            }
          }
        }
      }
    }
  ]
}
