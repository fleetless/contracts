{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "vat_id": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "const": "eligible"
        },
        "status": {
          "type": "string",
          "const": "valid"
        }
      },
      "required": [
        "vat_id",
        "name",
        "state",
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "vat_id": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "const": "refused"
        },
        "status": {
          "type": "string",
          "const": "invalid"
        },
        "rule": {
          "type": "string",
          "const": "vat_id_invalid"
        }
      },
      "required": [
        "vat_id",
        "name",
        "state",
        "status",
        "rule"
      ],
      "additionalProperties": false
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "vat_id": {
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "type": "string",
              "const": "pending"
            },
            "status": {
              "type": "string",
              "enum": [
                "valid",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "const": "vies_unavailable"
            },
            "vies_outage": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "enum": [
                    "member_state",
                    "vies"
                  ],
                  "description": "`member_state`: the VAT register of `country` does not answer VIES. `vies`: VIES itself does not answer."
                },
                "country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "description": "The billing address's country whose VAT ID was asked for. Greece is `GR`, never VIES's `EL`."
                }
              },
              "required": [
                "scope",
                "country"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "vat_id",
            "name",
            "state",
            "status",
            "reason",
            "vies_outage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "vat_id": {
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "type": "string",
              "const": "pending"
            },
            "status": {
              "type": "string",
              "enum": [
                "valid",
                "unverified",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "vies_unverified",
                "vies_identifier_missing"
              ]
            }
          },
          "required": [
            "vat_id",
            "name",
            "state",
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  ]
}
