{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "camera_start"
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "room": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "slug",
    "url",
    "room",
    "token"
  ],
  "additionalProperties": false
}
