          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "operation": {
                    "enum": [
                      "invoice_payment",
                      "payment_method_invoice"
                    ]
                  }
                },
                "required": [
                  "operation"
                ]
              },
              "then": {
                "required": [
                  "invoice_id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operation": {
                    "const": "mandate_setup"
                  }
                },
                "required": [
                  "operation"
                ]
              },
              "then": {
                "properties": {
                  "state": {
                    "const": "held"
                  },
                  "reason": {
                    "const": "mandate_policy_unresolved"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "reason": {
                    "const": "mandate_policy_unresolved"
                  }
                },
                "required": [
                  "reason"
                ]
              },
              "then": {
                "properties": {
                  "operation": {
                    "const": "mandate_setup"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "payment": {
                    "properties": {
                      "kind": {
