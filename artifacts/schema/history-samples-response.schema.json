{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "const": "samples"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {}
        },
        "required": [
          "timestamp_ms",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "slug",
    "kind",
    "samples",
    "truncated"
  ],
  "additionalProperties": false
}
